# Frontend build-time configuration. Never put secrets in these values.
#
# Local development needs no overrides: Vite serves the SPA on the page origin
# and proxies /api and /socket.io to http://localhost:3000.
# Copy this file to .env only when the local backend runs elsewhere.
# TWINDROP_BACKEND_URL=http://localhost:3000

# Optional local overrides. A production build rejects http origins, so keep
# these commented unless you are running the frontend locally.
# TWINDROP_SIGNALING_URL=http://localhost:3000
# TWINDROP_FRONTEND_URL=http://localhost:5173

# Production values are built in for Cloudflare Pages builds. Override them
# with Cloudflare Pages environment variables if the deployment changes.
# TWINDROP_SIGNALING_URL=https://twindrop-2uzn.onrender.com
# TWINDROP_FRONTEND_URL=https://t.sendcore.uz
