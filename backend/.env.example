# Local backend configuration. Copy to .env only for local development.
# Production values belong in Render environment variables, not in Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TWINDROP_LOG_LEVEL=debug

# In development the server automatically allows localhost:3000, :5173 and
# :8888. Override only when the frontend runs on another local origin.
# TWINDROP_FRONTEND_URL=http://localhost:5173
# TWINDROP_FRONTEND_ORIGINS=http://localhost:5173

# Socket.IO
TWINDROP_SOCKET_PATH=/socket.io
TWINDROP_RECONNECT_ATTEMPTS=4
TWINDROP_KEEPALIVE_INTERVAL_MS=140000
# TWINDROP_SELF_PING_URL=

# WebRTC ICE config (JSON array string). STUN is enough for local checks.
# TURN credentials must stay in environment variables and must not be committed.
TWINDROP_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# TWINDROP_ICE_SERVERS=[{"urls":["turn:turn.example.com:3478"],"username":"TURN_USERNAME","credential":"TURN_PASSWORD"}]

# Room and rate-limit tuning
TWINDROP_ROOM_CODE_LENGTH=6
TWINDROP_ROOM_CAPACITY=2
TWINDROP_ROOM_TTL_MS=3600000
TWINDROP_EMPTY_ROOM_TTL_MS=900000
TWINDROP_CLEANUP_INTERVAL_MS=60000
TWINDROP_REQUEST_WINDOW_MS=60000
TWINDROP_ROOM_CREATE_LIMIT=30
TWINDROP_ROOM_CHECK_LIMIT=120
TWINDROP_SOCKET_JOIN_LIMIT=20
TWINDROP_SOCKET_SIGNAL_LIMIT=240

# Payload and transfer limits
TWINDROP_MAX_HTTP_PAYLOAD_BYTES=16384
TWINDROP_MAX_SOCKET_PAYLOAD_BYTES=24576
TWINDROP_MAX_SIGNAL_PAYLOAD_BYTES=12288
TWINDROP_MAX_FILE_SIZE_BYTES=2147483648
TWINDROP_MAX_FILES_PER_TRANSFER=10
TWINDROP_ALLOWED_CHUNK_SIZES=16384,65536,131072,262144,524288
